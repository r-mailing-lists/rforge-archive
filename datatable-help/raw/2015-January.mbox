                                           expr      min       lq     mean   median       uq      max neval
 last3 <- flights[, .SD[nrow(.SD)], by = month] 15.63919 15.92073 17.28836 16.52588 18.33867 24.92624   100

>   identical(last1, last2)
[1] TRUE
>   identical(last1, last3)
