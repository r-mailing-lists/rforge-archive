          mean(x, na.rm=TRUE)
   }

   test.fun <- function(my.data, my.function) {
        my.data[,my.function(SCORE), by=ID]
   }

   my.result <- test.fun(test.data, my.mean)
  return(my.result)
}

outer.function(data.frame(ID=rep(1:2,  each=10), SCORE=rnorm(20)))

