[cut out data]

> # Variables I want to sum over each player:
> vars <- c('G', 'AB', 'R', 'H', 'X2B', 'X3B',
> ? ? ? ? ?'HR', 'RBI', 'SB', 'CS', 'BB', 'SO', 'IBB', 'HBP',
