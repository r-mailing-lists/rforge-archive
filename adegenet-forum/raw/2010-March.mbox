>  row.names(him) <- c("Chn","Dom","Tib","Bod","Gad","Raj","Mal","Gdb","Guj","GdR","Dgr","Pur","Zan","BrB","BrI","Bal","DgB","DaM","GaB","GjM","Chm")
> > row.names(him)
