Here is a draft solution with the built in example:

library(adegenet)
data(H3N2)
pop(H3N2) <- factor(H3N2$other$epid)
dapc1 <- dapc(H3N2, all.contrib=FALSE, scale=FALSE, n.pca=150, n.da=5)

hc <- hclust(dist(dapc1$grp.coord))
dend <- as.dendrogram(hc)
plot(dend)


HTH,
Vladimir

