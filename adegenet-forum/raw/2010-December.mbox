indC    pop1    1       1       0       1
indD    pop2    0       1       1       1
indD    pop2    0       1       1       1
indE    pop2    1       1       0       0
indE    pop2    1       1       0       0
indF    pop2    1       0       1       1
indF    pop2    1       0       1       1
indG    pop2    0       1       1       0
