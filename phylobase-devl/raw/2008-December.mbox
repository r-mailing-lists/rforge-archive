permtree <- function(phy) {
  phy$edge <- phy$edge[sample(nrow(phy$edge)),]
  phy
}

for (i in 1:40) {
  cat(i,"\n")
  ttp <- permtree(tt)
  plot(ttp)
}

  hangs R in an infinite loop on the second try ...
  I don't know whether pruningwise (or anything other
than cladewise will do it) ...

