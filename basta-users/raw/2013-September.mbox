# Here's the way to avoid the problem:
colnames(covars)[-1] <- letters[1:(ncol(covars) - 1)]
dat <- data.frame(birthDeath, Y[, -1], covars[, -1])

dat2 <- DataCheck(dat, studyStart = 1, studyEnd = 109, autofix = rep(1, 7),
